{
  "name": "numfmt",
  "description": "Full Excel style number formatting",
  "author": "Borgar Þorsteinsson <borgar@borgar.net>",
  "version": "3.2.6",
  "scripts": {
    "build": "NODE_ENV=production tsdown",
    "build:all": "npm run build && npm run docs",
    "docs": "typedoc && concat-md tempdocs > API.md && rm -rf tempdocs",
    "check": "npm run test && npm run lint && npm run typecheck",
    "lint": "eslint lib test",
    "release": "git diff --exit-code && PACKAGE_VERSION=$(jq -r .version package.json) && echo \"About to tag and push v$PACKAGE_VERSION. Continue? (y/n)\" && read -r REPLY && [ \"$REPLY\" = \"y\" ] && git tag --annotate v$PACKAGE_VERSION --message=v$PACKAGE_VERSION && git push origin v$PACKAGE_VERSION",
    "test": "SKIPTABLES=1 vitest run",
    "test-all": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "main": "dist/index.cjs",
  "types": "dist/index.d.cts",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.cts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "API.md",
    "LICENSE",
    "README.md"
  ],
  "tsdown": [
    {
      "entry": [ "lib/index.ts" ],
      "platform": "neutral",
      "format": [ "esm", "cjs" ],
      "sourcemap": true
    }
  ],
  "preferGlobal": false,
  "repository": {
    "type": "git",
    "url": "git://github.com/borgar/numfmt.git"
  },
  "homepage": "https://github.com/borgar/numfmt",
  "bugs": {
    "url": "http://github.com/borgar/numfmt/issues"
  },
  "keywords": [
    "excel",
    "spreadsheet",
    "xls",
    "xlsx",
    "number",
    "numberformat",
    "date",
    "format",
    "formatter"
  ],
  "license": "MIT",
  "devDependencies": {
    "@borgar/eslint-config": "~4.1.0",
    "@eslint/js": "~10.0.1",
    "@types/node": "~26.3.0",
    "concat-md": "~0.5.1",
    "eslint": "~10.9.1",
    "globals": "~17.11.0",
    "typedoc": "~0.28.20",
    "tsdown": "~0.22.14",
    "typedoc-plugin-markdown": "~4.12.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.68.0",
    "vitest": "~4.1.11"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
